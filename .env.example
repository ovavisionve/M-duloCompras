# Server
PORT=7000
NODE_ENV=development

# Database (opcion 1: campos individuales para desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comprar_ia
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database (opcion 2: URL completa para produccion/Neon)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

# BCV Exchange Rate API
BCV_API_URL=https://pydolarvenezuela-api.vercel.app/api/v1/dollar
BCV_CRON_SCHEDULE=0 9 * * *

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Webhooks
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=5000

# Company Info
COMPANY_RIF=J-12345678-9
COMPANY_NAME=Mi Empresa de Viajes C.A.

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
